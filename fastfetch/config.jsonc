{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color":{
	    "1": "light_blue",
	    "2": "light_magenta"
    }
  },
  "display": {
    "separator": " : ",
    "key": {
      "type": "icon"
    },
    "color": {
      "output": "white"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[35m┌──────────────────────── User ──────────────────────────┐\u001b[0m"
      
    },
    {
      "type": "title",
      "key": "   User",
      "KEYCOLOR": "magenta",
      "format": "{1}@{2}",
      "character": " "
    },
    {
      "type": "custom",
      "format": "\u001b[35m└────────────────────────────────────────────────────────┘\u001b[0m"
    }, 
    {
      "type": "custom",
      "format": "\u001b[32m┌─────────────────────── Hardware ───────────────────────┐\u001b[0m"
    },
    {
      "type": "host",
      "key": "  󰌢 Host",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "  ├──  CPU",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "  ├── 󰢮 GPU",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "  ├──  Mem",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "  └── 󰋊 Disk",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[32m└────────────────────────────────────────────────────────┘\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[36m┌─────────────────────── Software ───────────────────────┐\u001b[0m"
    },
    {
      "type": "os",
      "key": "  󰣇 OS",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "  ├──  Ker",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": "  ├──  Sh",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "  └──  Term",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "\u001b[36m└────────────────────────────────────────────────────────┘\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[34m┌─────────────────────── Time / Update ──────────────────┐\u001b[0m"
    },
    {
      "type": "uptime",
      "key": "  󱎫 Up",
      "keyColor": "blue"
    },
    {
      "type": "command",
      "key": "  ├── 󰚰 Last Upd",
      "keyColor": "blue",
      "shell": "fish",
      "text": "date -r /var/log/pacman.log '+%Y-%m-%d %H:%M:%S'"
    },
    {
      "type": "datetime",
      "key": "  └──  Date",
      "keyColor": "blue",
      "format": "{4} {5} "
    },
    {
      "type": "custom",
      "format": "\u001b[34m└────────────────────────────────────────────────────────┘\u001b[0m"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
